<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>zh_CN</string>
	<key>CFBundleExecutable</key>
	<string>TopologyKeeper</string>
	<key>CFBundleIconFile</key>
	<string>AppIcon</string>
	<key>CFBundleIdentifier</key>
	<string>com.iseku.topologykeeper</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>TopologyKeeper</string>
	<key>CFBundleDisplayName</key>
	<string>TopologyKeeper</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<!-- 发布版本号。注意与**功能阶段**编号（v1/v2/v3）区分：
	     后者指**功能阶段**，此处是**对外版本号**，两者不是一回事。
	     0.1.1：声道处理引擎总开关 + 直通模式（全断/直通/交换/混音四态）。
	     0.1.2：首页弹窗展开/收起日志时的闪动修复（最外层 frame 的对齐方式；
	            根因与实测见《交接说明.md》§8 坑 #31）。 -->
	<key>CFBundleShortVersionString</key>
	<string>0.1.2</string>
	<key>CFBundleVersion</key>
	<string>3</string>
	<key>LSMinimumSystemVersion</key>
	<string>13.0</string>
	<!-- 菜单栏应用：不出现在 Dock，也不占用 Cmd-Tab -->
	<key>LSUIElement</key>
	<true/>
	<!-- ★ 声道处理功能需要**读取** BlackHole 这个虚拟输入设备，
	     走的是 CoreAudio 的输入侧，会触发 TCC 的麦克风授权。
	     缺了这条 key，App 在首次读取输入时会**直接崩溃**（不是被拒绝）。
	     ⚠️ 文案必须同时覆盖「交换」与「混音」两个功能 —— 两者共用这条通路。 -->
	<key>NSMicrophoneUsageDescription</key>
	<string>TopologyKeeper 需要读取虚拟音频设备（如 BlackHole）的音频内容，用于声道交换与 LFE 混音后输出到播放设备。</string>
	<key>NSHighResolutionCapable</key>
	<true/>
	<key>NSSupportsAutomaticTermination</key>
	<false/>
	<key>NSSupportsSuddenTermination</key>
	<false/>
	<key>NSPrincipalClass</key>
	<string>NSApplication</string>
	<key>NSHumanReadableCopyright</key>
	<string>TopologyKeeper — 音频设备格式锁定工具</string>
</dict>
</plist>
